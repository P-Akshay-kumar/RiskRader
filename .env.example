# Database Configuration (Neon Postgres Async Connection String)
# Example Neon string: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./riskradar_dev.db

# CORS Configuration (comma-separated origins)
FRONTEND_ORIGIN=http://localhost:3000,https://risk-radar-two.vercel.app

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
